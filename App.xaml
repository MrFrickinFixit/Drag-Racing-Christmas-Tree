<Application x:Class="DragTree.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,6,0,6"/>
      <Setter Property="Background" Value="#35D9A0"/><Setter Property="Foreground" Value="#091711"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#303C4E"/><Setter Property="Foreground" Value="#C3CEDC"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111827"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="10"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111827"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Padding" Value="10"/></Style></Setter.Value></Setter></Style>
    <Style TargetType="Window"><Setter Property="Foreground" Value="#E8EDF5"/></Style>
  </Application.Resources>
</Application>
